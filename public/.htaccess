DirectoryIndex index.html
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
# Client-side routes that have a real view in hostinger/main.tsx. Keep all
# other paths as genuine 404s rather than masking broken links with the home page.
RewriteRule ^(workspace|personal|pricing|about|privacy|terms|login)/?$ index.html [L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
